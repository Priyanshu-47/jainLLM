{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jainllm-jainbench-v0",
  "title": "JainBench-v0 Evaluation Schema",
  "description": "Schema for JainBench-v0 evaluation questions. 150-200 questions covering Sthanakavasi sect knowledge, source-grounded citation, Prakrit terminology, multilingual ability, and abstention behavior. Questions must NOT overlap with SFT training data.",
  "type": "object",
  "required": ["bench_version", "questions"],
  "properties": {
    "bench_version": {
      "type": "string",
      "const": "jainbench-v0",
      "description": "Benchmark version identifier"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of benchmark creation"
    },
    "total_questions": {
      "type": "integer",
      "minimum": 150,
      "maximum": 200,
      "description": "Total number of questions"
    },
    "categories": {
      "type": "object",
      "description": "Category distribution with counts",
      "additionalProperties": {
        "type": "object",
        "required": ["count", "description"],
        "properties": {
          "count": {"type": "integer", "minimum": 1},
          "description": {"type": "string"}
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 150,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/BenchQuestion"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Benchmark metadata",
      "properties": {
        "corpus_version": {"type": "string"},
        "held_out_sources": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Source IDs excluded from SFT training for this benchmark"
        },
        "scoring_protocol": {"type": "string"},
        "inter_annotator_agreement": {"type": "string"}
      }
    }
  },
  "$defs": {
    "BenchQuestion": {
      "type": "object",
      "required": ["question_id", "category", "question", "expected_behavior", "scoring"],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^JB-v0-[0-9]{3}$",
          "description": "Unique question ID: JB-v0-001 through JB-v0-200"
        },
        "category": {
          "type": "string",
          "enum": [
            "sthanaqa_factual",
            "sthanaqa_doctrinal",
            "sthanaqa_history",
            "source_citation",
            "prakrit_term",
            "multilingual",
            "teacher_attribution",
            "canonical_commentary",
            "cross_tradition",
            "abstention",
            "conflicting_sources"
          ],
          "description": "Question category"
        },
        "question": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000,
          "description": "The question text"
        },
        "question_language": {
          "type": "string",
          "enum": ["en", "hi", "gu", "sa", "pra", "mixed"],
          "description": "Primary language of the question"
        },
        "expected_behavior": {
          "type": "string",
          "enum": [
            "answer_with_citation",
            "answer_with_source_grounding",
            "abstain_insufficient_evidence",
            "abstain_outside_scope",
            "provide_term_explanation",
            "distinguish_traditions",
            "distinguish_canonical_commentary",
            "bridge_languages"
          ],
          "description": "What the model should do"
        },
        "scoring": {
          "type": "object",
          "required": ["type"],
          "description": "How to score this question",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["exact_match", "fuzzy_match", "citation_check", "abstention_check", "likert", "rubric"],
              "description": "Scoring method"
            },
            "reference_answer": {
              "type": "string",
              "description": "Expected answer text (for exact/fuzzy match)"
            },
            "acceptable_answers": {
              "type": "array",
              "items": {"type": "string"},
              "description": "List of acceptable answer variants"
            },
            "required_citations": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Source IDs that MUST be cited in the answer"
            },
            "forbidden_citations": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Source IDs that must NOT be cited (cross-tradition traps)"
            },
            "required_abstention": {
              "type": "boolean",
              "description": "If true, the model MUST abstain (say 'I don't know' or equivalent)"
            },
            "rubric": {
              "type": "object",
              "description": "For rubric scoring: criteria with weight",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "weight": {"type": "number", "minimum": 0, "maximum": 1},
                  "description": {"type": "string"}
                }
              }
            }
          }
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "description": "Difficulty level"
        },
        "provenance_sources": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Source IDs that contain the answer (for answer verification)"
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Free-form tags"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes about this question"
        }
      }
    }
  }
}
