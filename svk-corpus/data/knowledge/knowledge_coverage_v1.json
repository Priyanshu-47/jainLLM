{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jainllm-knowledge-coverage-v1",
  "title": "JainLLM Knowledge Coverage Matrix v1",
  "description": "Maps the Jain knowledge landscape to assess coverage for retrieval, SFT, and evaluation. Each topic area is assessed against the current corpus and external source candidates. Counts are NOT populated from assumptions; UNKNOWN/0 is used where we have not audited.",
  "version": "1.0",
  "schema": {
    "topic_id": {
      "type": "string",
      "pattern": "^TOPIC-[0-9]{3}$",
      "description": "Unique topic identifier: TOPIC-NNN"
    },
    "topic_name": {
      "type": "string",
      "description": "Name of the knowledge area"
    },
    "category": {
      "type": "string",
      "enum": [
        "AGAMA",
        "PRACTICE",
        "PHILOSOPHY",
        "HISTORY",
        "BIOGRAPHY",
        "LEXICON",
        "CROSS_TRADITION",
        "MODERN",
        "LANGUAGE"
      ],
      "description": "High-level category"
    },
    "tradition_relevance": {
      "type": "string",
      "enum": [
        "STHANAKAVASI_ONLY",
        "SVETAMBARA_WIDE",
        "ALL_JAIN",
        "UNKNOWN"
      ],
      "description": "Which traditions this topic is relevant to"
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "STRONG",
        "PARTIAL",
        "WEAK",
        "MISSING",
        "RIGHTS_BLOCKED",
        "NEEDS_RESEARCH"
      ],
      "description": "Current coverage status in the corpus"
    },
    "retrieval_ready": {
      "type": "boolean",
      "description": "Whether retrieval-ready content exists for this topic"
    },
    "sft_ready": {
      "type": "boolean",
      "description": "Whether SFT-trainable content exists for this topic"
    },
    "evaluation_ready": {
      "type": "boolean",
      "description": "Whether evaluation questions can be generated for this topic"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of sources covering this topic (0 = not audited or none)"
    },
    "external_source_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of external source candidates for this topic"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text notes on coverage"
    }
  },
