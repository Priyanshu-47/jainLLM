{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jainllm-agam-inventory-v1",
  "title": "JainLLM Agam Inventory v1",
  "description": "Schema for recording the Jain canonical text inventory across traditions. This file defines the STRUCTURE only. It does NOT assert a final authoritative Agam list. Different sectarian inventories (Sthanakavasi, Murtipujaka, Digambara) may count and name Agams differently. This inventory must be capable of representing those differences without collapsing them.",
  "version": "1.0",
  "schema": {
    "agam_id": {
      "type": "string",
      "pattern": "^AGAM-[0-9]{3}$",
      "description": "Unique identifier: AGAM-NNN"
    },
    "traditional_name": {
      "type": "string",
      "description": "Name in original language (Sanskrit/Prakrit)"
    },
    "alternate_names": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Alternative names, transliterations, or translations"
    },
    "sequence_number": {
      "type": ["integer", "null"],
      "description": "Position in the traditional enumeration (varies by tradition)"
    },
    "group": {
      "type": "string",
      "enum": ["ANGA", "UPANGA", "MULASUTRA", "CHEDASUTRA", "PARISHISHTA", "PRATIYANUYOGA", "UNKNOWN"],
      "description": "Traditional grouping of the Agam"
    },
    "tradition": {
      "type": "string",
      "enum": ["STHANAKAVASI", "SVETAMBARA_GENERIC", "SVETAMBARA_MURTIPUJAKA", "TERAPANTHI", "DIGAMBARA", "MULTI_TRADITION", "UNKNOWN"],
      "description": "Tradition that recognizes this Agam"
    },
    "canonical_status": {
      "type": "string",
      "enum": ["CANONICAL", "CANONICAL_TRANSLATION", "COMMENTARY_ON_CANON", "TRADITIONAL_TEXT", "NON_CANONICAL", "UNKNOWN"],
      "description": "Canonical status in the tradition"
    },
    "source_id": {
      "type": ["string", "null"],
      "pattern": "^SVK-[0-9]+$",
      "description": "Link to source in source_registry if we have a text"
    },
    "source_basis": {
      "type": ["string", "null"],
      "description": "How the canonical status was determined (bibliographic_record, expert_knowledge, tradition_statement)"
    },
    "language": {
      "type": "string",
      "description": "Primary language of the Agam text"
    },
    "script": {
      "type": "string",
      "description": "Primary script"
    },
    "translation_available": {
      "type": "boolean",
      "description": "Whether a translation exists in our corpus or is publicly available"
    },
    "commentary_available": {
      "type": "boolean",
      "description": "Whether a commentary exists in our corpus or is publicly available"
    },
    "rights_status": {
      "type": "string",
      "enum": ["CLEAR", "PERMISSION_REQUIRED", "UNCLEAR", "RESTRICTED", "UNKNOWN"],
      "description": "Rights status of the specific text/translation we have access to"
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PROVISIONAL", "CONTESTED", "UNKNOWN"],
      "description": "How thoroughly this entry has been verified"
    }
  },
  "notes": [
    "The Sthanakavasi tradition traditionally recognizes 32 Agams (some sources say 34).",
    "The Murtipujaka tradition recognizes 45 Agams (the 'Jainaagam' set).",
    "The Digambara tradition has a different enumeration.",
    "This inventory does NOT take a position on which count is 'correct'.",
    "Entries are added as sources are acquired and verified, not by assertion.",
    "source_id links to source_registry_v1.json; null means no text acquired yet.",
    "source_basis is REQUIRED for VERIFIED canonical_status; null allowed for PROVISIONAL/UNKNOWN."
  ],
